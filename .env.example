# ==============================================================================
# 3-Tier Multi-Provider AI Fallback Strategy (Cheapest & Free Tiers First)
# ==============================================================================

# Priority 1: Direct Google Gemini Free Tier
# Free tier on Google AI Studio: https://aistudio.google.com/
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# or:
# GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Direct Gemini Model override (default: gemini-3.5-flash-lite)
AI_DIRECT_GEMINI_MODEL=gemini-3.5-flash-lite


# ------------------------------------------------------------------------------
# Priority 2: Vercel AI Gateway Free Model (Zero credits used!)
# Automatically used when Gemini free tier is rate-limited or depleted.
# ------------------------------------------------------------------------------
AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key_here

# Easily change the Vercel Gateway free model if free models change in the future:
# Options on Vercel AI Gateway:
# - nvidia/nemotron-3.5-lightning-free (Current default)
# - poolside/laguna-s-2.1-free
# - convaiinnovations/laya-free
# - reflection/beam-free
AI_GATEWAY_FREE_MODEL=nvidia/nemotron-3.5-lightning-free

# ------------------------------------------------------------------------------
# Priority 3: Vercel AI Gateway Credits Model (Paid credits used only as last resort)
# Used when both Priority 1 and Priority 2 free tiers are depleted.
# ------------------------------------------------------------------------------
# Options: google/gemini-2.5-flash | openai/gpt-4o-mini | moonshotai/kimi-k2
AI_GATEWAY_CREDIT_MODEL=google/gemini-2.5-flash

# ==============================================================================
# Existing Services (EmailJS)
# ==============================================================================
VITE_SERVICE_ID=your_emailjs_service_id
VITE_TEMPLATE_ID=your_emailjs_template_id
VITE_PUBLIC_KEY=your_emailjs_public_key
